{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(database|config|includes|auth|uploads/private_documents|uploads/test_results)(/.*)?$",
      "status": 404
    },
    {
      "src": "/(.*\\.php)$",
      "dest": "/api/index.php?path=$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?path=$1"
    }
  ]
}
