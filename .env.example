# Configure these in the Railway app service's Variables settings.
# Reference the attached MySQL service's variables where possible.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=nhre
DB_USER=your-mysql-user
DB_PASS=your-mysql-password

# Required only when seeding demo accounts; keep this private and unique.
NHRE_DEMO_PASSWORD=replace-with-a-private-password-of-at-least-16-characters

# Set these to database to share sessions and persist uploaded files across
# app instances. The app creates the required support tables automatically.
NHRE_SESSION_STORAGE=database
NHRE_FILE_STORAGE=database
