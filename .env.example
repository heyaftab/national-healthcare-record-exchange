# Configure these in Vercel Project Settings > Environment Variables.
# Use a managed MySQL database reachable from Vercel's serverless runtime.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=nhre
DB_USER=your-mysql-user
DB_PASS=your-mysql-password

# Set these to database to share sessions and persist uploaded files across
# Vercel invocations. The app creates the required support tables automatically.
NHRE_SESSION_STORAGE=database
NHRE_FILE_STORAGE=database
